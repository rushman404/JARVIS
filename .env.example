# =============================================================
# JARVIS - voorbeeld van de omgevingsvariabelen
# =============================================================
# Kopieer dit bestand naar `.env` en pas de waarden aan:
#     copy .env.example .env
# Zet NOOIT echte tokens of wachtwoorden in dit voorbeeldbestand.
# Laat een waarde leeg om de standaard uit config.py te gebruiken.
# =============================================================

# --- AI (Ollama) ---
# Naam van het Ollama-model.
AI_MODEL=qwen2.5:3b
# Contextgrootte in tokens. 8192 laat het model de systeemtekst +
# toolbeschrijvingen volledig lezen. Lager (bijv. 4096) kost minder
# geheugen en is wat sneller, maar dan kunnen tools worden afgekapt.
AI_NUM_CTX=8192
# Temperatuur voor gewone gesprekken (0.0 = feitelijk, 1.0 = los).
AI_TEMPERATURE_CHAT=0.3
# Hoe lang het model in het geheugen blijft na een opdracht.
AI_KEEP_ALIVE=30m

# --- Home Assistant (optioneel) ---
# Laat beide leeg als je geen Home Assistant gebruikt.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Extra veiligheid: zet op 1 om HA-bediening te beperken tot een
# expliciet toegestane lijst apparaten (standaard uit).
HA_CONTROL_SAFETY_ON=

# --- Spraak ---
# Specifiek microfoonapparaat (None = standaardapparaat).
MIC_DEVICE=

# --- Onderbreken (barge-in) ---
# Barge-in = JARVIS onderbreken terwijl hij praat.
# BARGE_IN_MODE:
#   'stem'      = de microfoon hoort je praten (handig met een headset)
#   'sneltoets' = alleen de sneltoets hieronder, de microfoon wordt niet
#                 afgeluisterd (veilig met speakers)
#   'uit'       = geen onderbreken
# Laat BARGE_IN_MODE leeg, dan kiest JARVIS zelf: 'stem' als er een headset
# wordt herkend, anders 'sneltoets'.
BARGE_IN_MODE=
# 1 = onderbreken aan, 0 = helemaal uit.
BARGE_IN_ENABLED=1
# Globale toets om JARVIS te onderbreken (notatie van het 'keyboard'-pakket).
BARGE_IN_HOTKEY=ctrl+alt+j
# Aantal aaneengesloten spraakstukken (30 ms per stuk) voor een onderbreking.
BARGE_IN_FRAMES=8
# Minimale geluidssterkte (RMS) voordat het als spraak telt.
BARGE_IN_MIN_RMS=1200
# Hoeveel keer langer het moet klinken dan JARVIS' eigen stem.
BARGE_IN_ECHO_RATIO=1.8
# De eerste seconden van het antwoord worden gebruikt om de echo van
# JARVIS' eigen stem te leren; in dat venster wordt niet onderbroken.
BARGE_IN_GRACE_SECONDS=0.35
# Venster waarmee de echo-drempel doorlopend wordt gevolgd. Kleiner = sneller
# reageren, groter = minder gevoelig voor harde eigen zinsdelen.
BARGE_IN_ECHO_WINDOW_SECONDS=1.5

# --- Power ---
# Wachttijd (seconden) voordat de pc echt afsluit/herstart; binnen dit
# venster kun je nog "annuleer afsluiten" zeggen.
POWER_COUNTDOWN_SECONDS=20

# --- Standaarddoel PC-bediening (Fase 15B) ---
# 'local'   = bedien deze pc (standaard)
# 'game-pc' = stuur PC-commando's naar de game-pc-agent; zet dit alleen als
#             de agent op de game-pc draait EN REMOTE_CLIENT_* hieronder is
#             ingesteld. Zonder werkende client krijg je een opstartmelding.
PC_TARGET=local

# --- Weer ---
# Standaardplaats voor het weer (stem en dashboard). Het dashboard gebruikt
# eerst een weather.*-entiteit uit Home Assistant als die er is.
JARVIS_WEER_PLAATS=Badhoevedorp

# --- Geheugen (Obsidian) ---
# Pad naar je Obsidian-vault voor het lange-termijngeheugen.
JARVIS_OBSIDIAN_VAULT=

# --- Geavanceerd / tests ---
# Adres van de Ollama-server.
OLLAMA_HOST=127.0.0.1:11434
# Zet in CI/tests op 1 om echte Ollama-aanroepen over te slaan.
# JARVIS_OLLAMA_DISABLED=1

# --- Fase 15: Game-PC Agent (remote) ---
# De SERVER draait op de game-pc; de CLIENT draait op het brein.
# Beveiliging is fail-closed: zonder token en certificaat start de
# server niet. Genereer een token met bijv.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Genereer het certificaat met:  python scripts/gen_remote_cert.py
#   (of met OpenSSL; zie docs/remote_agent.md)
# Standaard komen de sleutel en het certificaat in de map 'certs/'
# (staat in .gitignore - commit ze nooit).
# Volledige uitleg: docs/remote_agent.md
#
# De standaardinstellingen zijn veilig (uit / lokaal). Zet de server
# alleen aan als je de game-pc echt op afstand wilt bedienen.

# --- Server (game-pc) ---
REMOTE_SERVER_ENABLED=0
REMOTE_SERVER_HOST=0.0.0.0
REMOTE_SERVER_PORT=8765
REMOTE_SERVER_TOKEN=
REMOTE_SERVER_CERT_FILE=
REMOTE_SERVER_KEY_FILE=
# Komma-gescheiden lijst van toegestane client-IP-adressen. Vul hier het
# IP-adres van de mini-pc in (bijv. 192.168.1.50). Laat leeg om alleen
# privé-adressen toe te staan. Publieke adressen worden ALTIJD geweigerd.
REMOTE_SERVER_ALLOWED_IPS=

# Uitzonderingen op de server-denylist van programma's (cmd, powershell, ...).
# Standaard leeg: alles op de denylist wordt geweigerd.
REMOTE_EXTRA_ALLOWED_PROGRAMS=

# Serverprofiel: basis (standaard) of werkstation.
# basis  = alleen programma's/games, vensters, media/volume, audio
#          (uitlezen en per app bedienen), status en screenshot.
#          Veilig als je niet alles openzet.
# werkstation = alles: ook bestanden wijzigen, UI-automatisering, power
#          en browser. Alleen als je dit expliciet wilt.
REMOTE_SERVER_PROFILE=basis

# Maximaal aantal gelijktijdige verbindingen per client-IP (0 = geen limiet).
# Voorkomt dat één apparaat alle verbindingsplekken oprekt.
REMOTE_MAX_CONNECTIONS_PER_IP=4

# Limiet voor IP's die in REMOTE_SERVER_ALLOWED_IPS staan (0 = geen limiet).
# Standaard hoger, zodat het brein parallelle opdrachten plus een extra
# statuscheck kan doen. Bij een lege allowlist geldt voor iedereen
# minimaal EXECUTOR_MAX_WORKERS + 4.
REMOTE_MAX_CONNECTIONS_PER_ALLOWED_IP=12

# Totale deadline voor de TLS-handshake in seconden (niet per leesactie).
# Een handshake die langer duurt wordt afgebroken.
REMOTE_HANDSHAKE_DEADLINE_SECONDS=5

# --- Client (brein) ---
REMOTE_CLIENT_ENABLED=0
REMOTE_CLIENT_HOST=127.0.0.1
REMOTE_CLIENT_PORT=8765
REMOTE_CLIENT_TOKEN=
REMOTE_CLIENT_CA_FILE=
REMOTE_CLIENT_TIMEOUT=5

# Hoeveel seconden mag een ondertekend verzoek oud zijn (replay-bescherming).
REMOTE_REPLAY_WINDOW_SECONDS=30

# --- Dashboard (Fase 18) ---
# Het iPad-dashboard draait op het brein (laptop/mini-pc), alleen thuis en
# alleen via HTTPS. Fail-closed: zonder beide tokens en zonder certificaat
# start het dashboard niet. Zie docs/fase18_dashboard_design.md §10.
#   Tokens:       python -c "import secrets; print(secrets.token_urlsafe(32))"
#   Certificaat:  python scripts/make_dashboard_cert.py
DASHBOARD_ENABLED=0
DASHBOARD_HOST=0.0.0.0
# Poort van de dashboard-server (HTTPS voor de iPad). Deze MOET verschillen
# van REMOTE_SERVER_PORT hierboven: twee servers kunnen niet op dezelfde
# poort luisteren. Standaard 8780, terwijl de remote-server 8765 gebruikt.
DASHBOARD_PORT=8780
# kijk-token = alleen lezen; bedien-token = ook bedienen en goedkeuren.
# Twee verschillende tokens van minimaal 16 tekens.
DASHBOARD_VIEW_TOKEN=
DASHBOARD_CONTROL_TOKEN=
DASHBOARD_CERT_FILE=certs/dashboard-cert.pem
DASHBOARD_KEY_FILE=certs/dashboard-key.pem
# IP-adres van de iPad voor een extra laag (leeg = alle privé-adressen).
DASHBOARD_ALLOWED_IPS=
# LAN-adres van deze pc voor de Host/Origin-controle (leeg = automatisch).
DASHBOARD_LAN_IP=
# Verzoeken per IP per minuut.
DASHBOARD_RATE_LIMIT=120
# Hoe lang de koppelcode geldig is (seconden).
DASHBOARD_PAIR_CODE_TTL_SECONDS=300
